package example:example;

interface blobs {
  resource blob {
    constructor(contents: list<u8>);
    append: func(value: u8);
    append-global: func(value: u8);
    get-contents: func() -> list<u8>;
    get-global-contents: static func() -> list<u8>;
  }
}

interface processor {
  use blobs.{blob};

  process: func(b: borrow<blob>);
  later: func() -> list<u8>;
}

world processor-world {
  import blobs;
  export processor;
}

world example {
  export blobs;
  export call-gc: func();
  export get-global-contents: func() -> list<u8>;
}
