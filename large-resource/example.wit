package example:example;

interface blobs {
  resource blob {
    constructor(contents: list<u8>);
    append: func(value: u8);
    get-contents: func() -> list<u8>;
  }
}

interface processor {
  use blobs.{blob};

  process: func(b: borrow<blob>);
  later: func() -> list<u8>;
}

world processor-world {
  import blobs;
  export processor;
}

world example {
  export blobs;
}
